# Copy this file to .env and fill in real values before disabling MOCK_MODE.

# --- General ---
APP_NAME=Notification Service
# true  -> no real provider APIs are called; sends are simulated so you can
#          exercise the whole API with no credentials at all.
# false -> real Azure credentials below are required.
MOCK_MODE=false
DATABASE_PATH=notifications.db

# --- Authentication ---
# Set AUTH_ENABLED=true to require X-API-Key header on every /api/v1 request.
AUTH_ENABLED=false
AUTH_API_KEY=change-me-to-a-secret-key

# --- Email templates ---
# HTML templates live in templates/email/<name>.html with {{subject}}/{{body}}.
TEMPLATES_DIR=templates
EMAIL_TEMPLATE_NAME=default

# --- Azure Communication Services (WhatsApp + SMS + Email) ---
# One service, one connection string, all three channels.
# Azure portal -> Communication Services -> your resource -> Keys -> Connection string.
# NEVER commit a real value here; this file is the placeholder template.
COMMUNICATION_SERVICES_CONNECTION_STRING=
# Legacy alias (supported for backward compatibility):
# AZURE_COMMUNICATION_CONNECTION_STRING=your_azure_connection_string_here

# Country code used when a phone number has no country code (91 = India).
AZURE_DEFAULT_COUNTRY_CODE=91

# --- SMS ---
# SMS-enabled phone number from ACS (E.164, e.g. +919812345678).
AZURE_SMS_FROM=+919812345678

# --- Email ---
# Verified sender address in Azure Email Communication Service,
# e.g. DoNotReply@yourdomain.com
AZURE_EMAIL_FROM=DoNotReply@yourdomain.com

# --- WhatsApp ---
# Channel registration ID (Azure portal -> Advanced Messaging -> WhatsApp).
# Legacy alias AZURE_WHATSAPP_CHANNEL_ID is supported too.
WHATSAPP_CHANNEL_ID=your_whatsapp_channel_id_here
# WhatsApp business number linked to the channel (E.164) - used for logging only.
WHATSAPP_FROM=+91xxxxxxxxxx
# Approved template used for business-initiated messages (when the recipient
# has NOT messaged you first in the last 24h). Free-form text is only delivered
# inside a 24h session window. If the template has variables, provide them via
# template_params in the request ({{1}}={{name:"body", value:...}} or per-variable).
WHATSAPP_TEMPLATE_NAME=
# Language of the approved template, e.g. "en_US" or "en".
WHATSAPP_TEMPLATE_LANGUAGE=en_US
