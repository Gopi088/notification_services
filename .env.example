# Copy this file to .env and fill in real values before disabling MOCK_MODE.

# --- General ---
APP_NAME=Notification Service
# Application logging (DEBUG/INFO/WARNING/ERROR/CRITICAL). Logs go to stdout
# and, when LOG_FILE is set, to a rotating file.
# Terminal filtering: LOG_LEVEL=INFO shows ONLY INFO records (DEBUG/WARNING/
# ERROR/CRITICAL hidden). Mapping: DEBUG->DEBUG+INFO, INFO->INFO only,
# WARNING->WARNING+ERROR, ERROR->ERROR+CRITICAL, CRITICAL->CRITICAL.
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text (dev) or json (structured)
# When true and LOG_FORMAT=text, terminal logs are ANSI-coloured by level
# (DEBUG cyan, INFO green, WARNING yellow, ERROR red, CRITICAL magenta+bold).
# File logs are never coloured.
LOG_COLORS=true
LOG_FILE=logs/app.log
# Optional independent FILE level (standard threshold semantics). When empty,
# the file handler uses LOG_LEVEL but does NOT apply the exact-level terminal
# filter, so WARNING/ERROR are still written to disk.
LOG_FILE_LEVEL=
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUPS=5
# Dedicated AUDIT log file (JSON lines), SEPARATE from application logs.
# Every business/security action is appended here. View with:
#   python3 notification_service.py audit --file
AUDIT_LOG_FILE=logs/audit.log
# true  -> no real provider APIs are called; sends are simulated so you can
#          exercise the whole API with no credentials at all.
# false -> real Azure credentials below are required.
MOCK_MODE=false

# --- Database ---
# Storage backend: "sqlite" (local dev) or "postgres" (production).
STORAGE_BACKEND=sqlite
# SQLite file path (used when STORAGE_BACKEND=sqlite).
DATABASE_PATH=notifications.db
# PostgreSQL DSN (used when STORAGE_BACKEND=postgres). NEVER commit a real
# password here.
# Local Docker PostgreSQL:
# DATABASE_URL=postgresql://postgres:notifications@postgres:5432/notifications

# --- Authentication ---
# Set AUTH_ENABLED=true to require X-API-Key on notification API routes.
AUTH_ENABLED=false
AUTH_API_KEY=

# --- Duplicate detection ---
# Window (minutes) during which re-sending the SAME content (user + channel +
# recipient + message/template) is blocked with a "do you want to resend?"
# response. The same message sent OUTSIDE this window is a new notification.
# 0 disables window-based duplicate detection.
DUPLICATE_WINDOW_MINUTES=30

# --- Email templates ---
# HTML templates live in templates/email/<name>.html with {{subject}}/{{body}}.
TEMPLATES_DIR=templates
EMAIL_TEMPLATE_NAME=default

# --- Azure Communication Services (WhatsApp + SMS + Email) ---
# One service, one connection string, all three channels.
# Azure portal -> Communication Services -> your resource -> Keys -> Connection string.
# NEVER commit a real value here; this file is the placeholder template.
COMMUNICATION_SERVICES_CONNECTION_STRING=
# Legacy alias (supported for backward compatibility):
# AZURE_COMMUNICATION_CONNECTION_STRING=your_azure_connection_string_here

# Country code used when a phone number has no country code (91 = India).
AZURE_DEFAULT_COUNTRY_CODE=91

# --- SMS ---
# Default: Azure SMS (E.164, e.g. +919812345678).
AZURE_SMS_FROM=+919812345678

# --- Vonage SMS (optional alternative to Azure SMS) ---
# When VONAGE_API_KEY and VONAGE_API_SECRET are set, the SMS channel uses
# Vonage instead of Azure. Credentials from the Vonage dashboard.
# NEVER commit a real secret here.
VONAGE_API_KEY=
VONAGE_API_SECRET=
# SMS sender: E.164 number you own or an approved alphanumeric sender ID.
VONAGE_SMS_FROM=Vonage APIs

# --- Vonage WhatsApp Sandbox (optional alternative to Azure WhatsApp) ---
# When VONAGE_WHATSAPP_FROM is set, the WhatsApp channel uses the Vonage
# Messages Sandbox. Recipients must be allow-listed in the sandbox.
# The endpoint is configurable so it can later be switched to production.
VONAGE_WHATSAPP_FROM=14157386102
VONAGE_WHATSAPP_SANDBOX_URL=https://messages-sandbox.nexmo.com/v1/messages

# --- Twilio (optional SMS + WhatsApp provider) ---
# When TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are set, the SMS and WhatsApp
# channels use Twilio instead of Vonage/Azure. Twilio console -> Account ->
# API keys & tokens. NEVER commit a real secret here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender number (E.164, e.g. +17372508034).
TWILIO_FROM=
# Predefined SMS template name (Twilio TRIAL accounts can ONLY send predefined
# SMS templates, not free-form text - error 572006 otherwise). When set,
# free-form SMS is automatically retried as this template if Twilio rejects it.
# Example: sms_appointment_reminders
TWILIO_SMS_TEMPLATE=
# WhatsApp sender number (E.164). Falls back to TWILIO_FROM when empty.
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp content template SID used for template sends to NEW
# contacts (no 24h session required), e.g. HXfe5ab5f00277942d4d4200328b4d403c.
TWILIO_WHATSAPP_CONTENT_SID=
# Optional friendly-name -> ContentSid mapping so `send-template <number>
# <name>` works, e.g. test_template=HX...;reminder=HX...
TWILIO_WHATSAPP_TEMPLATES=

# --- Email ---
# Verified sender address in Azure Email Communication Service,
# e.g. DoNotReply@yourdomain.com
AZURE_EMAIL_FROM=DoNotReply@yourdomain.com

# --- WhatsApp ---
# Channel registration ID (Azure portal -> Advanced Messaging -> WhatsApp).
# Legacy alias AZURE_WHATSAPP_CHANNEL_ID is supported too.
WHATSAPP_CHANNEL_ID=your_whatsapp_channel_id_here
# WhatsApp business number linked to the channel (E.164) - used for logging only.
WHATSAPP_FROM=+91xxxxxxxxxx
# Approved template used for business-initiated messages (when the recipient
# has NOT messaged you first in the last 24h). Free-form text is only delivered
# inside a 24h session window. If the template has variables, provide them via
# template_params in the request ({{1}}={{name:"body", value:...}} or per-variable).
WHATSAPP_TEMPLATE_NAME=
# Language of the approved template, e.g. "en_US" or "en".
WHATSAPP_TEMPLATE_LANGUAGE=en_US
