# Never send local secrets or mutable runtime data to the Docker build context.
.env
.env.*
!.env.example
.aws/
credentials/
secrets/
*.key
*.pem
*.p12
*.pfx
*.secret
*.secrets

# Local development and test artifacts are not needed in the production image.
