.venv/
venv/
__pycache__/
.pytest_cache/
.coverage
*.pyc
*.db
*.db.*
*.sqlite
*.sqlite.*
notifications.db
logs/
*.jsonl
*.log
tests/
load_tests/
deploy/
.agents/
.codex/
.kilo/
.gitignore
README.md
docs/
examples/
*.md
