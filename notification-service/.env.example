# Copy this file to .env and fill in real values before disabling MOCK_MODE.

# --- General ---
APP_NAME=Notification Service
# true  -> no real provider APIs are called; sends are simulated so you can
#          exercise the whole API with no credentials at all.
# false -> real Twilio/SMTP credentials below are required.
MOCK_MODE=true
DATABASE_PATH=notifications.db

# --- Twilio (WhatsApp + SMS) ---
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155551234

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=you@example.com
SMTP_USE_TLS=true
